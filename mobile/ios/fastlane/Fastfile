default_platform(:ios)

platform :ios do
  desc "Install signing certificates and provisioning profiles (Match)"
  lane :sync_signing do
    match(type: "appstore", readonly: is_ci)
  end

  desc "Build Flutter iOS release without codesigning (CI artifact step)"
  lane :build_ci do
    sh("cd ../.. && flutter pub get")
    sh("cd ../.. && flutter build ios --release --no-codesign --build-number #{ENV['BUILD_NUMBER'] || '1'}")
  end

  desc "Build signed IPA for App Store / TestFlight"
  lane :build_release do
    sync_signing
    build_ci
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "../build/ios/ipa",
      output_name: "Status.ipa",
      include_bitcode: false,
      silent: true
    )
  end

  desc "Upload to TestFlight"
  lane :beta do
    build_release
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      apple_id: ENV["APPLE_ID"],
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    )
  end
end
