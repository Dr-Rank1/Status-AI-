# Copy to .env for local development (never commit .env)
API_BASE_URL=http://localhost:3000/api/v1
SOCKET_URL=http://localhost:3000
# TENANT_SLUG=default
# SIMLI_API_KEY=your-simli-api-key
# SPATIAL_MODE=true
# WEARABLE_MODE=true

# Federated learning sync key (must match backend FEDERATED_AGGREGATION_KEY in dev)
# FEDERATED_SYNC_KEY=status-fed-dev-key

# PostHog — feature flags & product analytics (Phase 17)
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com

# Sentry — crash reporting & RUM (Phase 17)
# SENTRY_DSN=https://...@sentry.io/...

# V2 Beta opt-in (Phase 31)
# V2_BETA_ENABLED=false

# RevenueCat — cross-platform subscriptions (Phase 26)
# REVENUECAT_IOS_API_KEY=appl_...
# REVENUECAT_ANDROID_API_KEY=goog_...

# Edge AI — INT8 ONNX + NPU inference (Phase 26)
# EDGE_INFERENCE_ENABLED=true
# ONNX_MODEL_PATH=assets/models/status_dm_int8.onnx

# Neuromorphic SNN bridge (Phase 32)
# NEUROMORPHIC_ENABLED=true

# Edge vector reads for wearable/spatial (Phase 33)
# EDGE_VECTOR_READ_PREFERRED=true
