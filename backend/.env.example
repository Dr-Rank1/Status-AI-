PORT=3000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/status

# AI_PROVIDER=mock
# AI_PROVIDER=auto          # Multi-LLM router (Anthropic DMs + Gemini feed)
# AI_PROVIDER=gemini
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Autonomous image generation (~35% of posts)
# IMAGE_GEN_ENABLED=true
# IMAGE_GEN_PROBABILITY=0.35

# Voice transcription (Whisper) + optional server TTS
# WHISPER_MODEL=whisper-1
# TTS_MODEL=tts-1
# TTS_VOICE=nova

# JWT Authentication
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Public URL for uploaded media (optional — auto-detected from request if unset)
# API_BASE_URL=http://localhost:3000

# Redis (optional — used for future WebSocket scaling / rate limiting)
# REDIS_URL=redis://localhost:6379

# Feed cache (Redis)
# FEED_CACHE_TTL=60

# AI rate limiting
# AI_RATE_LIMIT_MAX=30
# AI_RATE_LIMIT_WINDOW_MS=900000

# AI_RECENT_MESSAGES=6
# AI_SUMMARIZE_THRESHOLD=10
# AI_MAX_SUMMARY_CHARS=600

# Creator economy rewards (energy granted to character creators)
# CREATOR_REWARD_DM=3
# CREATOR_REWARD_FOLLOW=5
# CREATOR_REWARD_REPLY=2

# Narrative global events cron (default daily at noon)
# NARRATIVE_EVENT_CRON=0 12 * * *
# NARRATIVE_EVENT_HOURS=24

# OpenAI Moderation API (omni-moderation-latest)
# MODERATION_MODEL=omni-moderation-latest

# Vector memory (pgvector RAG)
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
# MEMORY_TOP_K=5
# MEMORY_MIN_SCORE=0.72

# Live streaming (LiveKit + Simli lip-sync)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# SIMLI_API_KEY=
# SUPER_CHAT_ENERGY_COST=25
# SUPER_CHAT_PIN_MINUTES=5
# TTS_STREAM_CHUNK_BYTES=4096

# Agentic tool calling (calendar, web search, external links)
# AGENT_TOOLS_ENABLED=true
# AGENT_MAX_STEPS=5
# OPENAI_AGENT_MODEL=gpt-4o-mini
# SERPER_API_KEY=

# Spatial computing (Phase 14 — processed context only, no raw mesh/eye data)
# SPATIAL_DATA_RESIDENCY=local
# SPATIAL_ALLOWED_REGIONS=local,us,eu
# SPATIAL_SENSITIVE_ZONES=[{"id":"bedroom","label":"Private bedroom","blockSpatialUpload":true}]

# Security hardening (Phase 16)
# CORS_ORIGINS=https://app.status.app,https://status.app
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# PAYMENT_RATE_LIMIT_MAX=5
# PAYMENT_RATE_LIMIT_WINDOW_MS=3600000

# Scheduled jobs (set CRON_ENABLED=false to disable)
CRON_ENABLED=true
AI_POST_CRON=0 */4 * * *
AI_POST_MIN_HOURS=4
ENERGY_DAILY_CRON=0 0 * * *
ENERGY_COOLDOWN_CRON=0 * * * *
ENERGY_COOLDOWN_AMOUNT=5
