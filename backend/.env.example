PORT=3000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/status

# AI_PROVIDER=mock
# AI_PROVIDER=auto          # Multi-LLM router (Anthropic DMs + Gemini feed)
# AI_PROVIDER=gemini
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Autonomous image generation (~35% of posts)
# IMAGE_GEN_ENABLED=true
# IMAGE_GEN_PROBABILITY=0.35

# Voice transcription (Whisper) + optional server TTS
# WHISPER_MODEL=whisper-1
# TTS_MODEL=tts-1
# TTS_VOICE=nova

# JWT Authentication
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Public URL for uploaded media (optional — auto-detected from request if unset)
# API_BASE_URL=http://localhost:3000

# Redis (optional — used for future WebSocket scaling / rate limiting)
# REDIS_URL=redis://localhost:6379

# Feed cache (Redis)
# FEED_CACHE_TTL=60

# AI rate limiting
# AI_RATE_LIMIT_MAX=30
# AI_RATE_LIMIT_WINDOW_MS=900000

# AI_RECENT_MESSAGES=6
# AI_SUMMARIZE_THRESHOLD=10
# AI_MAX_SUMMARY_CHARS=600

# Creator economy rewards (energy granted to character creators)
# CREATOR_REWARD_DM=3
# CREATOR_REWARD_FOLLOW=5
# CREATOR_REWARD_REPLY=2

# Narrative global events cron (default daily at noon)
# NARRATIVE_EVENT_CRON=0 12 * * *
# NARRATIVE_EVENT_HOURS=24

# OpenAI Moderation API (omni-moderation-latest)
# MODERATION_MODEL=omni-moderation-latest

# Vector memory (pgvector RAG)
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
# MEMORY_TOP_K=5
# MEMORY_MIN_SCORE=0.72

# Live streaming (LiveKit + Simli lip-sync)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# SIMLI_API_KEY=
# SUPER_CHAT_ENERGY_COST=25
# SUPER_CHAT_PIN_MINUTES=5
# TTS_STREAM_CHUNK_BYTES=4096

# Agentic tool calling (calendar, web search, external links)
# AGENT_TOOLS_ENABLED=true
# AGENT_MAX_STEPS=5
# OPENAI_AGENT_MODEL=gpt-4o-mini
# SERPER_API_KEY=

# Spatial computing (Phase 14 — processed context only, no raw mesh/eye data)
# SPATIAL_DATA_RESIDENCY=local
# SPATIAL_ALLOWED_REGIONS=local,us,eu
# SPATIAL_SENSITIVE_ZONES=[{"id":"bedroom","label":"Private bedroom","blockSpatialUpload":true}]

# Security hardening (Phase 16)
# CORS_ORIGINS=https://app.status.app,https://status.app
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# PAYMENT_RATE_LIMIT_MAX=5
# PAYMENT_RATE_LIMIT_WINDOW_MS=3600000

# PostHog — feature flags & AI telemetry attribution (Phase 17)
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com

# Sentry — crash reporting (Phase 17)
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=status-backend@0.1.0

# Multi-region HA (Phase 18)
# REGION_ID=us-east-1
# REGION_NAME=US East
# REGION_PEER_URLS=eu-west-1=https://status-eu.example.com,ap-southeast-1=https://status-ap.example.com

# Circuit breaker — LLM provider protection
# AI_CB_FAILURE_THRESHOLD=5
# AI_CB_LATENCY_MS=10000
# AI_CB_RESET_MS=30000
# AI_CACHE_TTL_SEC=3600

# Event streaming — Kafka / Redpanda
# KAFKA_BROKERS=localhost:9092
# REDPANDA_BROKERS=redpanda:9092
# KAFKA_TOPIC_ENERGY=status.energy.events
# KAFKA_TOPIC_REPUTATION=status.reputation.events

# Self-hosted vLLM inference (Phase 19 — Llama 3)
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# VLLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# VLLM_API_KEY=status-vllm-local
# SELF_HOSTED_AI_PREFERRED=true

# Fine-tuning data export (Phase 19)
# FINE_TUNING_EXPORT_ENABLED=true
# FINE_TUNING_EXPORT_CRON=0 3 * * 0
# FINE_TUNING_EXPORT_LIMIT=5000
# FINE_TUNING_OUTPUT_DIR=./data/fine-tuning

# Agent wallets & micropayments (Phase 20)
# AGENT_WALLET_ENERGY_POOL=500
# AGENT_TIP_ENERGY=8
# AGENT_TIP_TOKEN=2
# AGENT_TIP_MIN_LIKES=5
# AGENT_TIP_SWEEP_CRON=0 */6 * * *

# Decentralized storage (Phase 20)
# IPFS_MOCK_MODE=true
# IPFS_API_URL=http://127.0.0.1:5001
# IPFS_GATEWAY=https://ipfs.io/ipfs
# IPFS_AUTO_PIN=false
# ARWEAVE_GATEWAY=https://arweave.net

# Zero-knowledge proofs (Phase 20)
# ZKP_PEPPER=change-me-in-production
# ZKP_PROOF_TTL_MS=3600000
# ZKP_VIP_REPUTATION=500

# Multi-agent coordination (Phase 21)
# MULTI_AGENT_ENABLED=true

# Federated learning (Phase 21)
# FEDERATED_AGGREGATION_KEY=change-me-in-production
# FEDERATED_WEIGHT_DIM=32

# Public developer API (Phase 21)
# OAUTH_TOKEN_TTL_SEC=3600
# PUBLIC_API_RATE_MAX=120
# WEBHOOK_TIMEOUT_MS=8000

# AI governance & compliance (Phase 22)
# CONSENT_POLICY_VERSION=2026-01

# Post-quantum hybrid auth (Phase 22)
# PQ_AUTH_ENABLED=true
# PQ_AUTH_PEPPER=change-me-in-production
# PQ_AUTH_ALGORITHM=ml-dsa-65-hybrid-v1

# Global CDN (Phase 22)
# CDN_BASE_URL=https://cdn.status.app
# CDN_UPLOADS_PREFIX=/media
# CDN_MODELS_PREFIX=/avatars-3d

# Read replica routing (Phase 22)
# DATABASE_READ_URL=postgresql://...
# DATABASE_READ_URLS=eu-west-1=postgresql://...,ap-southeast-1=postgresql://...
# DEFAULT_READ_REGION=us-east-1

# AI anomaly alerting (Phase 22)
# AI_ANOMALY_LATENCY_MS=15000
# SLACK_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# PAGERDUTY_ROUTING_KEY=

# Autonomous self-healing (Phase 23)
# SELF_HEALING_ENABLED=true
# SELF_HEALING_AUTO_APPLY=true
# SELF_HEALING_INTERVAL_MS=60000
# SELF_HEALING_CONFIG=deploy/self-healing/daemon.config.json
# SELF_HEALING_CRON=*/5 * * * *

# Synthetic simulation engine (Phase 23)
# SYNTHETIC_SIM_ENABLED=true
# SYNTHETIC_STAGING_ONLY=true
# SYNTHETIC_PERSONA_COUNT=100
# SYNTHETIC_TURNS_PER_PERSONA=3
# SYNTHETIC_SIM_CRON=0 2 * * *

# Affective biometrics (Phase 24)
# AFFECTIVE_BIOMETRICS=true

# P2P mesh networking (Phase 24)
# MESH_NETWORK_ENABLED=true
# MESH_PEER_TTL_MS=120000
# MESH_CLUSTER_ID=status-local

# Metaverse export (Phase 24)
# METAVERSE_SYNC_TTL_SEC=3600

# Multi-tenant white-label (Phase 25)
# DEFAULT_TENANT_SLUG=default
# TENANT_SLUG=default

# RevenueCat subscriptions (Phase 26)
# REVENUECAT_WEBHOOK_SECRET=your-webhook-secret
# REVENUECAT_PRO_PRODUCT_IDS=status_pro_monthly,status_pro_yearly,pro

# Scheduled jobs (set CRON_ENABLED=false to disable)
CRON_ENABLED=true
AI_POST_CRON=0 */4 * * *
AI_POST_MIN_HOURS=4
ENERGY_DAILY_CRON=0 0 * * *
ENERGY_COOLDOWN_CRON=0 * * * *
ENERGY_COOLDOWN_AMOUNT=5
