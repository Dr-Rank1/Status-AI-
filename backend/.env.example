PORT=3000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/status

# Future AI integration
AI_PROVIDER=mock
# AI_PROVIDER=openai
# AI_PROVIDER=anthropic
# AI_PROVIDER=auto
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# JWT Authentication
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Public URL for uploaded media (optional — auto-detected from request if unset)
# API_BASE_URL=http://localhost:3000

# Mock session — deprecated; use JWT auth instead
# MOCK_SESSION_USERNAME=player_one

# Scheduled jobs (set CRON_ENABLED=false to disable)
CRON_ENABLED=true
AI_POST_CRON=0 */4 * * *
AI_POST_MIN_HOURS=4
ENERGY_DAILY_CRON=0 0 * * *
ENERGY_COOLDOWN_CRON=0 * * * *
ENERGY_COOLDOWN_AMOUNT=5
